# clangd config for the Arduino sketches in this repo.
#
# The entries in compile_commands.json were generated by arduino-cli for the
# ESP32 (xtensa) cross-toolchain.  clangd parses them with the host clang, so
# two adjustments are needed:
#
# 1. Zed passes --query-driver (see .zed/settings.json) so clangd asks the
#    real xtensa-esp32-elf-g++ for its target and system include paths.
#
# 2. -nostdlibinc stops the host clang from appending Arch's /usr/include to
#    the search path.  Without it, glibc's <limits.h> leaks in through
#    include_next chains and fails on undefined __GLIBC_USE.
CompileFlags:
  Add: [-nostdlibinc]
