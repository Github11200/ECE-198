{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:file((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:file",
      "internal": true,
      "priority": true,
      "missing": [
        {
          "type": "header",
          "key": "x-nextjs-data"
        }
      ],
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+))/$"
    },
    {
      "source": "/:notfile((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+)",
      "destination": "/:notfile/",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+))$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/participants",
      "regex": "^/admin/participants(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/participants(?:/)?$"
    },
    {
      "page": "/admin/sessions",
      "regex": "^/admin/sessions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/sessions(?:/)?$"
    },
    {
      "page": "/cancer-exercise-program",
      "regex": "^/cancer\\-exercise\\-program(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cancer\\-exercise\\-program(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/login/admin",
      "regex": "^/login/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login/admin(?:/)?$"
    },
    {
      "page": "/login/participant",
      "regex": "^/login/participant(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login/participant(?:/)?$"
    },
    {
      "page": "/participant",
      "regex": "^/participant(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/participant(?:/)?$"
    },
    {
      "page": "/participant/progress",
      "regex": "^/participant/progress(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/participant/progress(?:/)?$"
    },
    {
      "page": "/rehabilitation-programme",
      "regex": "^/rehabilitation\\-programme(?:/)?$",
